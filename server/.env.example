DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=financewise
PORT=3001

# Auth
# JWT_SECRET must be a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_long_random_string
# Set AUTH_PASSWORD for local/dev use, or set AUTH_PASSWORD_HASH (a bcrypt hash) in production instead
AUTH_PASSWORD=your_login_password_here
# Comma-separated list of origins allowed to call this API with credentials
CLIENT_ORIGIN=http://localhost:5173

# AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
