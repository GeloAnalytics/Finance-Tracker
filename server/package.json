{
  "name": "financewise-server",
  "version": "1.0.0",
  "description": "FinanceWise API Server — Personal Finance Tracker & AI Advisor",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "tsx src/db/seed.ts",
    "hash-password": "tsx src/scripts/hash-password.ts",
    "test": "vitest run",
    "migrate:up": "node scripts/migrate.cjs up",
    "migrate:down": "node scripts/migrate.cjs down",
    "migrate:create": "node scripts/migrate.cjs create",
    "lint": "eslint ."
  },
  "dependencies": {
    "@google/genai": "^1.51.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
